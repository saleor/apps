{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cleanup-stale-installations",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "src/pages/api/webhooks/*": {
      "memory": 1769,
      "maxDuration": 20
    }
  },
  "regions": ["dub1", "iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  }
}
