{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "saleor-app-aboard",
  "version": "1.0.1",
  "private": true,
  "license": "(BSD-3-Clause AND CC-BY-4.0)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:ci": "pnpm run build",
    "check-types": "next typegen && tsc",
    "dev": "NODE_OPTIONS='--inspect' next dev",
