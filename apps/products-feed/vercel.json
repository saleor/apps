{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/set-deprecation",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/pages/api/feed/**/*": {
      "memory": 3008,
      "maxDuration": 300
    },
    "src/pages/api/cron/*": {
      "maxDuration": 300
    }
  },
  "regions": ["dub1", "iad1"],
  "git": {
    "deploymentEnabled": {
      "oss-sync-staging": false,
      "public-mirror": false
    }
  }
}
