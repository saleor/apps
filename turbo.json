{
  "$schema": "https://turbo.build/schema.v2.json",
  "globalDependencies": ["**/.env.*local", "schema.graphql", "saleor-json-schemas/**"],
  "globalEnv": [
    "APP_LOG_LEVEL",
    "CI",
    "ENABLE_EXPERIMENTAL_COREPACK",
    "ENV",
    "NEW_SECRET_KEY",
    "NEXT_RUNTIME",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "OTEL_ACCESS_TOKEN",
    "OTEL_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_LOG_LEVEL",
    "OTEL_SERVICE_NAME",
    "OTEL_TRACES_SAMPLER_ARG",
    "OTEL_TRACES_SAMPLER",
    "PORT",
    "REPOSITORY_URL",
    "SALEOR_CLOUD_API_URL",
    "SALEOR_CLOUD_OIDC_AUDIENCE",
    "SALEOR_CLOUD_ROOT_DOMAINS",
    "STALE_INSTALLATIONS_CLEANUP_DRY_RUN",
    "SENTRY_ORG",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!vercel.json"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".vercel/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": ["GITHUB_SHA", "VERCEL_GIT_COMMIT_SHA"]
    },
    "build:ci": {
      // CI-only: proves each app builds and type-checks (next build runs tsc over the whole
      // tsconfig, tests included). No outputs, so the cache stores only pass/fail; .next would
      // crowd the GitHub cache. topo makes upstream package changes rebuild dependents.
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!vercel.json"],
      "outputs": [],
      // Placeholders set by the CI job: env schemas are validated when route modules load.
      "passThroughEnv": [
        "ALLOWED_DOMAIN_PATTERN",
        "AWS_REGION",
        "CRON_SECRET",
        "DYNAMODB_LOGS_TABLE_NAME",
        "DYNAMODB_MAIN_TABLE_NAME",
        "ENGINE_CONTROL_PLANE_URL",
        "MCP_TOKEN_ENCRYPTION_KEY",
        "NEXT_PUBLIC_INITIAL_CHANNEL_SLUG",
        "REQUEST_SECRET",
        "S3_BUCKET_NAME",
        "SECRET_KEY"
      ]
    },
    "check-types": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!vercel.json"]
    },
    "deploy": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", ".vercel/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "env": ["GITHUB_SHA", "VERCEL_GIT_COMMIT_SHA"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      // Codegen reads only its own package (documents, config, schema), so no topo: upstream
      // changes would rerun it for nothing. TS is an input because some apps still write
      // documents inline (gql`...` scanned by codegen, gql.tada). TODO: move inline documents
      // to .graphql files, drop the TS globs from codegen `documents`, then drop TS here.
      "inputs": [
        "**/*.graphql",
        "**/*.ts",
        "**/*.tsx",
        "package.json",
        "tsconfig.json",
        "!**/.next/**",
        "!**/next-env.d.ts"
      ],
      "outputs": ["generated/**"]
    },
    "start": {
      "dependsOn": ["^build", "^start"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "test:ci": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"]
    }
  }
}
